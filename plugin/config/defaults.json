{
  "provider": "openai-realtime",
  "openai": {
    "model": "gpt-realtime-2.1-mini",
    "voice": "marin",
    "speed": 1.2,
    "reasoningEffort": "minimal",
    "apiKeyEnv": "OPENAI_REALTIME_API_KEY",
    "transcription": {
      "model": "gpt-live-transcribe",
      "language": "th"
    },
    "turnDetection": {
      "type": "server_vad",
      "threshold": 0.6,
      "prefixPaddingMs": 300,
      "silenceDurationMs": 1000
    },
    "noiseReduction": "near_field",
    "understanding": {
      "enabled": true,
      "api": "decisions",
      "model": "gpt-6-luna",
      "timeoutMs": 2000,
      "minConfidence": 0.4,
      "pricingUsd": { "inPerMTok": 0.1, "outPerMTok": 0 }
    },
    "pricingUsd": {
      "textInPerMTok": 4,
      "audioOutPerMTok": 64,
      "textOutPerMTok": 16,
      "transcriptionPerMin": 0.017
    },
    "speechPricingUsd": {
      "gpt-realtime-2.1": { "textInPerMTok": 4, "audioOutPerMTok": 64, "textOutPerMTok": 16 },
      "gpt-realtime-2.1-mini": { "textInPerMTok": 0.6, "audioOutPerMTok": 20, "textOutPerMTok": 2.4 }
    }
  },
  "audio": {
    "echoCancellation": true,
    "autoGain": false,
    "noiseGate": { "enabled": true, "openDb": 12, "minDb": -55, "holdMs": 350, "lookaheadMs": 120 }
  },
  "conversation": {
    "endOfReplyMs": 400,
    "unfinishedReplyMs": 3500,
    "discussEndOfReplyMs": 1200,
    "replyTimeoutSec": 180,
    "bargeInConfirmMs": 500,
    "minUtteranceMs": 300,
    "recapAfterPauseSec": 60,
    "acknowledgements": ["ค่ะ", "รับทราบค่ะ", "โอเคค่ะ"],
    "thinkingCue": "tone",
    "thinkingCueAfterMs": 3000,
    "thinkingCueRepeatMs": 8000
  },
  "session": {
    "idleDisconnectMin": 10,
    "refreshAfterMin": 50
  },
  "vocabulary": [
    "Wayfinder", "Claude Code", "ticket", "map", "grilling", "prototype", "research", "task",
    "issue", "GitHub", "pull request", "API", "MCP", "plugin", "mod", "skill", "frontend",
    "backend", "deploy", "database", "schema", "spec", "Supabase", "Vercel", "Next.js"
  ],
  "logDir": null
}
